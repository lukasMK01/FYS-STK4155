    "# standardised features and an 80/20 split, as in the week-41 solutions\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "#initialise the weights and biases\n",
    "def init_layers(sizes, seed):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    return [(rng.standard_normal((n_in, n_out)) / np.sqrt(n_in), np.random.rand(n_out)*1e-9) #weights are initialised with a normal distribution with mean 0 and variance 1/n_in, biases are initialised to very small random values\n",
    "            for n_in, n_out in zip(sizes[:-1], sizes[1:])]\n",
    "\n",
    "#using MSE as the cost function:\n",
    "def cost_batch(layers, inputs, activation_funcs, targets):\n",
    "    return mse(feed_forward_batch(inputs, layers, activation_funcs), targets)\n",
    "\n",
    "\n",
    "#setting up the input and target data:\n",
    "def prepare_data(x,y):\n",
    "    \"\"\"splits into train and test, prepares design matrix and scales data\"\"\"\n",
    "\n",
    "    #split into train and test data\n",
    "    x_tr, x_te, y_tr, y_te = train_test_split(x, y, test_size=0.2, random_state=2026)\n",
    "\n",
    "    # create design matrix, expanding the dimensions of x and y to make them 2D arrays with one column each\n",
    "    X_train = np.expand_dims(x_tr, axis=1)\n",
    "    X_test = np.expand_dims(x_te, axis=1) \n",
    "\n",
    "    #need to expand the dimensions of y as well, to make it a 2D array with one column\n",
    "    y_tr = np.expand_dims(y_tr, axis=1)\n",
    "    y_te = np.expand_dims(y_te, axis=1)\n",
    "\n",
    "    #centering and scaling the data\n",
    "    x_tr_std = (X_train - X_train.mean(axis=0)) / X_train.std(axis=0)\n",
    "    y_tr_norm = y_tr# - y_tr.mean(axis=0)\n",
    "\n",
    "    x_te_std = (X_test - X_train.mean(axis=0)) / X_train.std(axis=0)\n",
    "    y_te_norm = y_te# - y_te.mean(axis=0)\n",
    "\n",
    "    return x_tr_std, x_te_std, y_tr_norm, y_te_norm\n",
    "\n",
    "\n",
    "#From weekly exercises, incorporated into the optimiser_step function\n",
    "def gd_step(layers, grads, gamma, state=None):\n",
    "    \"\"\"Plain gradient descent on a list of (W, b): theta <- theta - gamma * grad.\"\"\"\n",
    "    return [(W - gamma * dW, b - gamma * db) for (W, b), (dW, db) in zip(layers, grads)], state\n",
    "\n",
    "def momentum_step(layers, grads, gamma, state=None, beta=0.9):\n",
    "    \"\"\"SGD with momentum: v <- beta v + gamma grad, theta <- theta - v.\n",
    "    The velocities live in `state`, one (vW, vb) per layer.\"\"\"\n",
    "    if state is None:\n",
    "        state = [(np.zeros_like(W), np.zeros_like(b)) for W, b in layers]\n",
    "    state = [(beta * vW + gamma * dW, beta * vb + gamma * db) for (vW, vb), (dW, db) in zip(state, grads)]\n",
    "    layers = [(W - vW, b - vb) for (W, b), (vW, vb) in zip(layers, state)]\n",
    "    return layers, state\n",
    "\n",
    "\n",
    "#Function from exercises, equations for various methods with gradient descent \n",
    "#help from copilot with in-line suggestions based on the original function with linear regression, that was looked through before (if) accepted\n",
    "def optimiser_step(method, layers, grads, gamma, t,state=None, beta=0.9, rho=0.99,\n",
    "                   beta1=0.9, beta2=0.999, eps=1e-8):\n",
    "    \"\"\"One update of theta from the gradient g at step t (t = 1, 2, ...), Eqs. (4.10), (4.28),\n",
    "    (4.42)-(4.45), (4.47)-(4.48) and (4.51)-(4.55).  state carries the running quantities.\"\"\"\n",
    "    if method == \"plain\":\n",
    "        return [(W - gamma * dW, b - gamma * db) for (W, b), (dW, db) in zip(layers, grads)], state #theta - gamma * g, state\n",
    "    if method == \"momentum\":\n",
    "        if state is None:\n",
    "            state = [(np.zeros_like(W), np.zeros_like(b)) for W, b in layers]\n",
    "        state = [(beta * vW + gamma * dW, beta * vb + gamma * db) for (vW, vb), (dW, db) in zip(state, grads)]\n",
    "        layers = [(W - vW, b - vb) for (W, b), (vW, vb) in zip(layers, state)]\n",
    "        return layers, state\n",
    "    if method == \"rmsprop\":\n",
    "        if state is None:\n",
    "            state = [(np.zeros_like(W), np.zeros_like(b)) for W, b in layers]\n",
    "        state = [(rho * rW + (1.0 - rho) * dW * dW, rho * rb + (1.0 - rho) * db * db) for (rW, rb), (dW, db) in zip(state, grads)]\n",
    "        layers = [(W - gamma * dW / (np.sqrt(rW) + eps), b - gamma * db / (np.sqrt(rb) + eps)) for (W, b), (dW, db), (rW, rb) in zip(layers, grads, state)]\n",
    "        return layers, state  \n",
    "    if method == \"adam\": #help from local chat to debug the code and come with suggestions for fix for adam implementation\n",
    "        if state is None:\n",
    "            m_state = [(np.zeros_like(W), np.zeros_like(b)) for W, b in layers]\n",
    "            r_state = [(np.zeros_like(W), np.zeros_like(b)) for W, b in layers]      \n",
    "        else:\n",
    "            m_state, r_state = state\n",
    "        m_state = [(beta1 * mW + (1.0 - beta1) * dW, beta1 * mb + (1.0 - beta1) * db) for (mW, mb), (dW, db) in zip(m_state, grads)]\n",
    "        r_state = [(beta2 * rW + (1.0 - beta2) * dW * dW, beta2 * rb + (1.0 - beta2) * db * db) for (rW, rb), (dW, db) in zip(r_state, grads)]\n",
    "        state = [m_state,r_state]\n",
    "        layers = [(W - gamma * (mW / (1.0 - beta1**t)) / (np.sqrt(rW / (1.0 - beta2**t)) + eps), b - gamma * (mb / (1.0 - beta1**t)) / (np.sqrt(rb / (1.0 - beta2**t)) + eps)) for (W, b), (mW, mb), (rW, rb) in zip(layers, m_state, r_state)]\n",
    "        return layers, state \n",
    "    raise ValueError(f\"unknown method {method}\")\n",
    "\n",
    "\n",
    "def OLS_regression(X, y):\n",
    "    \"\"\" set up the design function, based on a 5th degree polynomial, and return the closed form solution with y tilde as the predicted target\"\"\"\n",
    "    theta = closed_form(np.column_stack([X**i for i in range(6)]), y)\n",
    "\n",
    "    predict_OLS = np.polyval(theta[::-1], X)\n",
    "\n",
    "    return predict_OLS\n",
    "\n",
    "def predict(X, layers, hidden_activation=\"sigmoid\"):\n",
    "    \"\"\"The output of the network\"\"\"\n",
    "    return feed_forward_batch(X, layers, hidden_activation)\n",
    "\n",
    "\n",
    "\n",
    "#function from exercises, tweaked to match the project\n",
    "def train(layers, X, y, X_test, y_test, step, act, act_der, gamma, epochs, batch_size=None, seed=2026):\n",
    "    \"\"\"batch_size=None: full-batch gradient descent; otherwise minibatches drawn without\n",
    "    replacement from a fresh shuffle every epoch.  Returns the trained layers and a history\n",
    "    of (epoch, training cost, test accuracy).\"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n = len(X)\n",
    "    M = n if batch_size is None else batch_size\n",
    "    state, history = None, []\n",
    "    t = 0\n",
    "    prediction = []\n",
    "    for epoch in range(1, epochs + 1):\n",
    "        perm = rng.permutation(n)\n",
    "        for start in range(0, n, M):\n",
    "            \n",
    "            idx = perm[start:start + M]\n",
    "            grads = backpropagation_batch(X[idx], layers, act, y[idx], act_der)\n",
    "\n",
    "            t += 1\n",
    "            layers, state = optimiser_step(step, layers, grads, gamma, t, state)\n",
    "\n",
    "        #The MSE as cost, for train and test data\n",
    "        history.append((epoch, float(cost_batch(layers, X, act, y)),float(cost_batch(layers, X_test, act, y_test))))\n",
    "        prediction.append(feed_forward_batch(X_test, layers, act)) \n",
    "    return layers, np.array(history), prediction\n",
    "\n",
    "def setup_NN(\n",
    "    X_shape,\n",
    "    y_shape,\n",
    "    design_hidden:list,\n",
    "    activation_funcs:callable=ReLU,\n",
    "    activation_ders:callable=ReLU_der,\n",
    "    activation_output: callable=identity,\n",
    "    activation_output_der: callable=identity_der,\n",
    "):\n",
    "    \"\"\"Set up a neural network with the layers and activation functions.\"\"\"\n",
    "    layers = init_layers([X_shape[1]] + design_hidden + [y_shape[1]], seed=2026)\n",
    "    activation_funcs = [activation_funcs] * len(design_hidden) + [activation_output]\n",
    "    activation_ders = [activation_ders] * len(design_hidden) + [activation_output_der]\n",
    "\n",
    "    return layers, activation_funcs, activation_ders\n",
    "\n"
   ]
