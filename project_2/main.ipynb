    "# Cross-validation to find the best learning rate for each of the three different SGD methods, based on the CV MSE\n",
    "\n",
    "def cv_mse_nopen(hidden, nlayer, gamma=0.01, lam=0, norm=None, k=5, epochs=200, activation=sigmoid,activation_der=sigmoid_der,step=\"adam\"):\n",
    "    \"\"\"5-fold CV MSE on the training data for one network setting. The validation MSE of a fold is\n",
    "    averaged over the last 10 epochs, to remove jittering.\"\"\"\n",
    "    scores = []\n",
    "    for tr, va in KFold(k, shuffle=True, random_state=2026).split(x_tr):\n",
    "        layers, act, der = setup_NN(x_tr.shape, y_tr.shape, design_hidden=nlayer*[hidden], activation_funcs=activation, activation_ders=activation_der, activation_output=identity, activation_output_der=identity_der)\n",
    "        _, hist, _ = train(layers, x_tr[tr], y_tr[tr], x_tr[va], y_tr[va],\n",
    "                                  step, act, der, gamma, epochs,batch_size=15)\n",
    "\n",
    "        scores.append(hist[-10:, 2].mean())\n",
    "    return float(np.mean(scores)), float(np.std(scores))/np.sqrt(len(scores))\n",
    "\n",
    "\n",
    "gammas = [0.0001,0.0002,0.0005,0.001, 0.002, 0.005, 0.01, 0.02, 0.05, 0.1, 0.5]\n",
    "\n",
    "#Looping over different gammas for the three different SGD methods, to find the best learning rate for each method, based on the CV MSE\n",
    "grid_gammas = {}\n",
    "grid_se = {}\n",
    "for name in [\"plain\",\"rmsprop\",\"adam\"]:\n",
    "    score_mean = []\n",
    "    score_se = []\n",
    "    for gamma in gammas:\n",
    "\n",
    "        mean, se = cv_mse_nopen(50, 1, gamma, activation=sigmoid,activation_der=sigmoid_der,step=name)\n",
    "        score_mean.append(mean)\n",
    "        score_se.append(se)\n",
    "        print(f\"CV MSE with learning rate {gamma}: {mean:.4f}\")\n",
    "    \n",
    "    grid_gammas[name], grid_se[name] = np.array(score_mean).reshape(1, len(gammas)), np.array(score_se).reshape(1, len(gammas))  \n",
    "inds = [\"a\", \"b\", \"c\"]\n",
    "eb_colors = []\n",
    "fig, axes = plt.subplots(1, 3, figsize=(12, 4), constrained_layout=True,sharey=True)\n",
    "for ax, name, ind in zip(axes, [\"plain\", \"rmsprop\", \"adam\"], inds):\n",
    "\n",
    "    markers,_,lines = ax.errorbar(np.arange(len(gammas)), grid_gammas[name][0], yerr = grid_se[name], fmt='o',label=\"CV MSE (errors of 1 se)\")\n",
    "    i_best = np.unravel_index(np.nanargmin(grid_gammas[name]), grid_gammas[name].shape)\n",
    "    within = grid_gammas[name] <= grid_gammas[name][i_best] + grid_se[name][i_best]\n",
    "        \n",
    "    print(\"Learning rates that achieve CV MSE within 1 standard error of the best:\", np.array(gammas)[within[0]], f\"({name})\")\n",
    "    ax.add_patch(plt.Rectangle((i_best[1] - 0.5, np.nanmin(grid_gammas[name])-8e-3), 1, 2e-2, fill=False, edgecolor=\"red\", lw=3,zorder=1,label=\"lowest CV MSE\")) \n",
    "\n",
    "    print(\"Minimum learning rate within 1 standard error:\", (np.array(gammas)[within[0]])[0], f\"({name})\")\n",
    "    ax.add_patch(plt.Rectangle((gammas.index((np.array(gammas)[within[0]])[0]) - 0.5, np.nanmin(grid_gammas[name])-8e-3), 1, 2e-2, fill=False, edgecolor=\"black\", lw=3, linestyle=\"--\",zorder=2,label=\"min $\\gamma$ within 1 se\")) \n",
    "        \n",
    "    ax.set_yscale(\"log\")\n",
    "    \n",
    "    ax.set_xticks(np.arange(len(gammas)))\n",
    "    ax.set_xticklabels(gammas,rotation=270)\n",
    "    ax.set_xlabel(\"Initial learning rates\", fontsize=label_fontsize)\n",
    "    ax.set_title(f\"{ind}) 5-fold CV-MSE ({name}) SGD\", fontsize=title_fontsize)\n",
    "    ax.tick_params(axis='both', which='both', labelsize=tick_fontsize)\n",
    "    \n",
    "axes[2].legend(fontsize=legend_fontsize,loc=\"upper right\")\n",
    "    \n",
    "# fig.suptitle(\"5-fold CV MSE\",fontsize=title_fontsize)\n",
    "plt.savefig(\"./figures/partb_gammas.png\", dpi=500)\n",
    "plt.show()\n",
    "\n"
   ]
