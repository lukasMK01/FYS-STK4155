    "\n",
    "#function from part d but tweaked\n",
    "def heatmap_nopen(ax, grid, row_labels, col_labels, title, ylabel, xlabel,vmin=0.01, vmax=0.2, grid_se=None):\n",
    "    \"\"\"Heat map of CV MSE (log colour scale) with the value written in every cell;\n",
    "    the best cell gets a red frame.\"\"\"\n",
    "    cmap = plt.get_cmap(\"viridis_r\")\n",
    "    norm = LogNorm(vmin=vmin, vmax=vmax)\n",
    "    ax.imshow(grid, cmap=cmap, norm=norm, aspect=\"auto\")          # row 0 is drawn at the top\n",
    "    \n",
    "    i_best = np.unravel_index(np.argmin(grid), grid.shape)\n",
    "    within = grid <= grid[i_best] + grid_se[i_best]\n",
    "\n",
    "    for i in range(grid.shape[0]):\n",
    "        for j in range(grid.shape[1]):\n",
    "            r, g, b, _ = cmap(norm(grid[i, j]))                   # colour of this cell\n",
    "            text_color = \"white\" if 0.299 * r + 0.587 * g + 0.114 * b < 0.5 else \"black\"   # readable on dark/light\n",
    "            ax.text(j, i, f\"{grid[i, j]:.3f}\", ha=\"center\", va=\"center\", color=text_color, fontsize=8,\n",
    "                    fontweight=\"bold\" if within is not None and within[i, j] else \"normal\")\n",
    " \n",
    "    i, j = np.unravel_index(np.nanargmin(grid), grid.shape)\n",
    " \n",
    "    ax.add_patch(plt.Rectangle((j - 0.5, i - 0.5), 1, 1, fill=False, edgecolor=\"red\", lw=3))   # cell centres are at integers\n",
    "    ax.set_xticks(range(len(col_labels)))\n",
    "    ax.set_xticklabels(col_labels)\n",
    "    ax.set_yticks(range(len(row_labels)))\n",
    "    ax.set_yticklabels(row_labels)\n",
    "    ax.tick_params(axis='both', which='both', labelsize=tick_fontsize)\n",
    "    ax.set_title(title, fontsize=title_fontsize)\n",
    "    ax.set_xlabel(xlabel, fontsize=label_fontsize)\n",
    "    ax.set_ylabel(ylabel, fontsize=label_fontsize)\n",
    "\n",
    "\n",
    "\n",
    "nlayers = [1,2,3,4]\n",
    "nodes = [10, 50, 100,500]\n",
    "\n",
    "grid_layernodes = {}\n",
    "grid_se = {}\n",
    "for name, act, act_der in [(\"sigmoid\", sigmoid, sigmoid_der),(\"ReLU\", ReLU, ReLU_der), (\"Leaky ReLU\", leaky_ReLU, leaky_ReLU_der)]:\n",
    "    score_mean = []\n",
    "    score_se = []\n",
    "    for node in nodes:\n",
    "        for nlayer in nlayers:\n",
    "            mean, se = cv_mse_nopen(node, nlayer, 0.005, activation=act,activation_der=act_der)\n",
    "            score_mean.append(mean)\n",
    "            score_se.append(se)\n",
    "            print(f\"CV MSE for {nlayer} hidden layers and {node} nodes per layer with {name}: {mean:.4f}\")\n",
    "    \n",
    "    grid_layernodes[name], grid_se[name] = np.array(score_mean).reshape(len(nlayers), len(nodes)), np.array(score_se).reshape(len(nlayers), len(nodes))  \n",
    "\n",
    "inds = [\"a\", \"b\", \"c\"]\n",
    "fig, axes = plt.subplots(1, 3, figsize=(12, 4), constrained_layout=True)\n",
    "for ax, name, ind in zip(axes, [\"sigmoid\", \"ReLU\", \"Leaky ReLU\"], inds):\n",
    "\n",
    "    heatmap_nopen(ax, grid_layernodes[name], nlayers, [n for n in nodes], f\"{ind}) {name}\", r\"Hidden layers\",r\"Nodes per layer\", grid_se=grid_se[name])\n",
    "    ax.add_patch(plt.Rectangle((1 - 0.5, 0 - 0.5), 1, 1, fill=False, edgecolor=\"black\", lw=3, linestyle=\"--\"))   # choice of parameters due to 1se rule\n",
    "\n",
    "fig.suptitle(\"5-fold CV MSE, Adam SGD\",fontsize=title_fontsize)\n",
    "plt.savefig(\"./figures/partc_nlayers_nodes.png\", dpi=500)\n",
    "plt.show()\n",
    "\n"
   ]
