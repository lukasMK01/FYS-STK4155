    "###################################\n",
    "# final training, comparison with OLS / Ridge / Lasso\n",
    "###################################\n",
    "seeds = [2026]\n",
    "# seeds = range(10) #for a mean +- spread over several runs (10 times slower)\n",
    "\n",
    "# 1x50 network chosen with the 1-se rule, without penalty and with L2 / L1 (set your lambdas)\n",
    "choice[\"unpenalised_1se\"] = ([50], 0.0, \"l2\", None)\n",
    "choice[\"l2_1se\"] = ([50], 1e-3, \"l2\", None)\n",
    "choice[\"l1_1se\"] = ([50], 1e-3, \"l1\", None)\n",
    "\n",
    "x_mean, x_std = x_tr_raw.mean(), x_tr_raw.std() # the same scaling as in prepare_data\n",
    "xx = np.linspace(-1, 1, 400) # dense grid for plotting the fits\n",
    "xx_std = ((xx - x_mean) / x_std).reshape(-1, 1)\n",
    "\n",
    "final = {} # name -> dict with the results\n",
    "for name, (hid, lam, norm, _) in choice.items():\n",
    "    tr_err, te_err = [], []\n",
    "    for seed in seeds:\n",
    "        layers, act, der = build_net(hid, seed=seed)\n",
    "        layers, hist = train_penalised(layers, x_tr, y_tr, x_te, y_te, \"adam\", act, der,\n",
    "                                       best_gamma, 200, lam, norm, seed=seed)\n",
    "        tr_err.append(hist[-1, 1]) # MSE after the last epoch\n",
    "        te_err.append(hist[-1, 2])\n",
    "        if seed == seeds[0]: # keep the fit of the first run for the plot\n",
    "            curve = feed_forward_batch(xx_std, layers, act)[:, 0]\n",
    "    final[name] = dict(train=np.mean(tr_err), test=np.mean(te_err), test_std=np.std(te_err), curve=curve)\n",
    "\n",
    "### Table\n",
    "print(f\"\\n{'model':30s} {'settings':34s} {'train MSE':>9s} {'test MSE':>9s}\")\n",
    "rows = []\n",
    "for kind in [\"OLS\", \"Ridge\", \"Lasso\"]:\n",
    "    cv_err, d, lam, tr_m, te_m = baseline[kind]\n",
    "    s = f\"degree {d}\" + (\"\" if kind == \"OLS\" else f\", lambda={lam:.0e}\")\n",
    "    rows.append((kind + \" (polynomial)\", s, tr_m, te_m, 0.0))\n",
    "for name, label in [(\"unpenalised\", \"NN, no penalty\"), (\"l2\", \"NN + L2\"), (\"l1\", \"NN + L1\"),\n",
    "                    (\"unpenalised_1se\", \"NN 1x50, no penalty\"), (\"l2_1se\", \"NN 1x50 + L2\"), (\"l1_1se\", \"NN 1x50 + L1\")]: # NEW: last three\n",
    "    hid, lam, norm, _ = choice[name]\n",
    "    s = f\"{len(hid)}x{hid[0]}, lambda={lam:g}, gamma={best_gamma}\"\n",
    "    rows.append((label, s, final[name][\"train\"], final[name][\"test\"], final[name][\"test_std\"]))\n",
    "for r in rows:\n",
    "    spread = f\" +- {r[4]:.4f}\" if r[4] > 0 else \"\" # the spread only exists with several seeds\n",
    "    print(f\"{r[0]:30s} {r[1]:34s} {r[2]:9.4f} {r[3]:9.4f}{spread}\")\n",
    "print(f\"{'noise level of test points':30s} {'':34s} {'':9s} {noise_floor:9.4f}\")\n",
    "\n",
    "### Figure: (a) fits of the regularised models, (b) test MSE of all models\n",
    "fig, ax = plt.subplots(1, 2, figsize=(11, 4.3), constrained_layout=True)\n",
    "\n",
    "ax[0].plot(xx, runge(xx), \"k:\", label=\"Runge function\")\n",
    "ax[0].scatter(x_te_raw, y_te_raw, s=14, color=\"#A0720E\", label=\"test data\")\n",
    "ax[0].plot(xx, baseline_models[\"Ridge\"].predict(xx.reshape(-1, 1)), color=RED, alpha=0.7, ls=\"--\", label=\"Ridge\")\n",
    "ax[0].plot(xx, baseline_models[\"Lasso\"].predict(xx.reshape(-1, 1)), color=GREEN, alpha=0.7, ls=\"--\", label=\"Lasso\")\n",
    "ax[0].plot(xx, final[\"l2\"][\"curve\"], color=RED, ls=\"-\", lw=1, alpha=1, label=\"NN + L2\")\n",
    "ax[0].plot(xx, final[\"l1\"][\"curve\"], color=GREEN, ls=\"-\", lw=1, alpha=1, label=\"NN + L1\")\n",
    "ax[0].plot(xx, final[\"l2_1se\"][\"curve\"], color=RED, ls=\"-.\", lw=1, alpha=0.5, label=\"NN 1x50 + L2\")\n",
    "ax[0].plot(xx, final[\"l1_1se\"][\"curve\"], color=GREEN, ls=\"-.\", lw=1, alpha=0.5, label=\"NN 1x50 + L1\")\n",
    "ax[0].set_xlabel(\"x\"); ax[0].set_ylabel(\"y\"); ax[0].legend(fontsize=8)\n",
    "ax[0].set_title(\"a) fits of the regularised models\")\n",
    "\n",
    "labels = [r[0] for r in rows]\n",
    "bars = ax[1].bar(range(len(rows)), [r[3] for r in rows], yerr=[r[4] for r in rows],\n",
    "                 color=[GREY, GREY, GREY, BLUE, RED, GREEN, BLUE, RED, GREEN], capsize=3) \n",
    "for b in bars[6:]:\n",
