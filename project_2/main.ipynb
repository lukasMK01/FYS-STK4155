    "###################################\n",
    "# the benchmarks from project 1 (OLS, Ridge, Lasso on polynomial features)\n",
    "###################################\n",
    "\n",
    "import warnings\n",
    "from sklearn.exceptions import ConvergenceWarning\n",
    "warnings.filterwarnings(\"ignore\", category=ConvergenceWarning)   # remove annoying warnings\n",
    "\n",
    "# The same 80/20 split as the network, but with the raw x (the polynomial pipeline scales itself)\n",
    "x_tr_raw, x_te_raw, y_tr_raw, y_te_raw = train_test_split(x, y, test_size=0.2, random_state=2026)\n",
    "assert np.allclose(y_tr_raw, y_tr.ravel()) # check: same training points as the network\n",
    "\n",
    "def fit_poly(kind, degree, lam, x_fit, y_fit):\n",
    "    \"\"\"Polynomial regression as in project 1 (PolynomialFeatures -> StandardScaler -> model).\n",
    "    lam is defined as for the network:  cost = MSE + lam*sum(theta^2)  or  MSE + lam*sum(|theta|).\n",
    "    scikit-learn uses other normalisations, so the conversion is\n",
    "        Ridge:  ||y - X theta||^2 + alpha ||theta||^2        ->  alpha = n * lam\n",
    "        Lasso:  ||y - X theta||^2 / (2n) + alpha |theta|_1    ->  alpha = lam / 2   (as in project 1)\"\"\"\n",
    "    if kind == \"OLS\":\n",
    "        reg = LinearRegression()\n",
    "    elif kind == \"Ridge\":\n",
    "        reg = Ridge(alpha=len(x_fit) * lam)\n",
    "    else:\n",
    "        reg = Lasso(alpha=lam / 2.0, max_iter=100000)\n",
    "    model = make_pipeline(PolynomialFeatures(degree, include_bias=False), StandardScaler(), reg)\n",
    "    return model.fit(x_fit.reshape(-1, 1), y_fit)\n",
    "\n",
    "# 5-fold cross-validation on the TRAINING data only (the test set is not touched here).\n",
    "# NB: these are the same folds that are used for the network below.\n",
    "kfold = KFold(5, shuffle=True, random_state=2026)\n",
    "def poly_cv(kind, degree, lam):\n",
    "    errs = []\n",
    "    for tr, va in kfold.split(x_tr_raw):\n",
    "        m = fit_poly(kind, degree, lam, x_tr_raw[tr], y_tr_raw[tr])\n",
    "        errs.append(np.mean((y_tr_raw[va] - m.predict(x_tr_raw[va].reshape(-1, 1))) ** 2))\n",
    "    return np.mean(errs)\n",
    "\n",
    "degrees = list(range(1, 13)) # polynomial degrees as in project 1\n",
    "poly_lams = np.logspace(-6, 0, 13) # lambda grid for Ridge and Lasso\n",
    "\n",
    "baseline = {} # kind -> (cv mse, degree, lambda)\n",
    "for kind in [\"OLS\", \"Ridge\", \"Lasso\"]:\n",
    "    best = (np.inf, None, None)\n",
    "    for d in degrees:\n",
    "        for lam in ([0.0] if kind == \"OLS\" else poly_lams):\n",
    "            err = poly_cv(kind, d, lam)\n",
    "            if err < best[0]:\n",
    "                best = (err, d, lam)\n",
    "    baseline[kind] = best\n",
    "    print(f\"{kind:5s}: best CV-MSE = {best[0]:.4f} at degree {best[1]}\" +\n",
    "          (\"\" if kind == \"OLS\" else f\", lambda = {best[2]:.1e}\"))\n",
    "\n",
    "# Refit the three winners on all 80 training points and evaluate on the 20 test points\n",
    "baseline_models = {}\n",
    "for kind, (cv_err, d, lam) in baseline.items():\n",
    "    m = fit_poly(kind, d, lam, x_tr_raw, y_tr_raw)\n",
    "    baseline_models[kind] = m\n",
    "    train_mse = np.mean((y_tr_raw - m.predict(x_tr_raw.reshape(-1, 1))) ** 2)\n",
    "    test_mse = np.mean((y_te_raw - m.predict(x_te_raw.reshape(-1, 1))) ** 2)\n",
    "    baseline[kind] = (cv_err, d, lam, train_mse, test_mse)\n",
    "    print(f\"{kind:5s}: train MSE = {train_mse:.4f}, test MSE = {test_mse:.4f}\")\n",
    "\n",
    "# The best any model can do on these 20 test points is the noise in them:\n",
    "noise_floor = np.mean((y_te_raw - runge(x_te_raw)) ** 2)\n",
    "print(f\"noise level on the test points (true Runge function vs data): {noise_floor:.4f}  (sigma^2 = {sigma**2})\")\n"
